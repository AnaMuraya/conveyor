# Copy to .env and adjust. `.env` is git-ignored; this example is committed.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=conveyor

# Set to 'true' to log SQL.
DB_LOGGING=false

# Redis (BullMQ queue between API and worker).
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT auth (ADR-0009). MUST be set to a strong secret in any real deployment;
# the app falls back to an insecure dev default if unset.
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=1h
